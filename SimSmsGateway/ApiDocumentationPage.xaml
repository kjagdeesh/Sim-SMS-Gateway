<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SimSmsGateway.ApiDocumentationPage"
             Shell.NavBarIsVisible="False"
             Title="API documentation">
    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
            <Image Source="simsmsgatewaylogo.svg" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" />
            <Label Grid.Column="1" StyleClass="ShellPageTitle" Text="API documentation" />
        </Grid>
    </Shell.TitleView>
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="20,28,20,28" Spacing="16">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Margin="0,0,0,30">
                <Button StyleClass="Secondary"
                        WidthRequest="46"
                        HeightRequest="46"
                        Padding="0"
                        Text="&#xf060;"
                        FontFamily="FASolid"
                        Clicked="OnBackClicked"
                        SemanticProperties.Description="Back" />
                
                <!--<Border Grid.Column="1" StyleClass="IconBox">
                    <Label StyleClass="Icon" Text="&#xf1c9;" />
                </Border>-->
                
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                    <Label StyleClass="Title" FontSize="23" Text="API Documentation" />
                </VerticalStackLayout>
            </Grid>

            <Border StyleClass="Hero">
                <VerticalStackLayout Spacing="10">
                    <Label Text="REST API" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.4" TextColor="#5EEAD4" />
                    <Label Text="Send SMS from any app" FontFamily="OpenSansSemibold" FontSize="24" TextColor="White" />
                    <Label FontSize="13" TextColor="#C7DADD" LineHeight="1.3"
                           Text="Five JSON endpoints served by this phone. Use them from a backend, script or website on the same trusted network." />
                </VerticalStackLayout>
            </Border>

            <Border StyleClass="Card">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border StyleClass="IconBox"><Label StyleClass="Icon" Text="&#xf135;" /></Border>
                        <Label Grid.Column="1" StyleClass="Heading" Text="Getting started" VerticalOptions="Center" />
                    </Grid>
                    <Label StyleClass="Body" Text="Base URL: the Wi-Fi address on the Server page, for example http://192.168.1.25:8765." />
                    <Label StyleClass="Body" Text="Authentication: send Authorization: Bearer YOUR_API_KEY on every endpoint except /health." />
                    <Label StyleClass="Body" Text="Format: JSON requests use Content-Type: application/json. Numbers must be E.164, like +919876543210." />
                    <Border StyleClass="Warn" Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label FontFamily="FASolid" FontSize="14" Text="&#xf071;" TextColor="#B7791F" VerticalOptions="Start" />
                            <Label Grid.Column="1" StyleClass="WarnText"
                                   Text="Security: the gateway uses plain HTTP. Use a trusted network and never expose its port to the internet." />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="Endpoints" Spacing="14" />

            <Button StyleClass="Secondary" Text="Open OpenAPI specification" Clicked="OnOpenSpecClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
