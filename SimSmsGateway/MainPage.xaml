<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SimSmsGateway.MainPage"
             BackgroundColor="#F4F7F9"
             Title="SIM Relay">
    <ScrollView>
        <VerticalStackLayout Padding="22,28,22,32" Spacing="20">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <VerticalStackLayout Spacing="3">
                    <Label Text="SIM RELAY"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#147D72"
                           CharacterSpacing="1.7" />
                    <Label Text="Your phone. Your SIM."
                           FontSize="27"
                           FontAttributes="Bold"
                           TextColor="#142A32" />
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        Padding="11,7"
                        StrokeThickness="0"
                        BackgroundColor="#E4F3EF"
                        StrokeShape="RoundRectangle 16"
                        VerticalOptions="Center">
                    <Label Text="ANDROID GATEWAY"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="#147D72"
                           CharacterSpacing="0.5" />
                </Border>
                <Label Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Margin="0,6,0,0"
                       Text="A self-hosted SMS API, powered by your carrier."
                       FontSize="14"
                       TextColor="#63777D" />
            </Grid>

            <Border Padding="18"
                    BackgroundColor="White"
                    Stroke="#E1E9EB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Gateway status"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#142A32" />
                            <Label x:Name="StatusLabel"
                                   Text="Stopped"
                                   FontSize="13"
                                   TextColor="#63777D" />
                        </VerticalStackLayout>
                        <Border x:Name="StatusPill"
                                Grid.Column="1"
                                Padding="10,6"
                                BackgroundColor="#F0F3F4"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                VerticalOptions="Center">
                            <Label x:Name="StatusPillLabel"
                                   Text="OFFLINE"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#63777D"
                                   CharacterSpacing="0.8" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button x:Name="StartButton"
                                Text="Start server"
                                Clicked="OnStartClicked"
                                BackgroundColor="#147D72"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="13"
                                HeightRequest="48" />
                        <Button x:Name="StopButton"
                                Grid.Column="1"
                                Text="Stop server"
                                Clicked="OnStopClicked"
                                IsEnabled="False"
                                BackgroundColor="#EEF2F3"
                                TextColor="#31474E"
                                FontAttributes="Bold"
                                CornerRadius="13"
                                HeightRequest="48" />
                    </Grid>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="SERVER ADDRESS"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#75888D"
                               CharacterSpacing="1" />
                        <Label x:Name="AddressLabel"
                               Text="Start the server to see its address"
                               FontSize="14"
                               TextColor="#142A32"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Padding="18"
                    BackgroundColor="White"
                    Stroke="#E1E9EB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="API access key"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#142A32" />
                    <Label Text="Paste this key into your browser playground. It is generated on this device."
                           FontSize="13"
                           TextColor="#63777D" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                        <Entry x:Name="ApiKeyEntry"
                               IsReadOnly="True"
                               IsPassword="True"
                               FontSize="13"
                               BackgroundColor="#F4F7F9"
                               TextColor="#31474E"
                               HorizontalTextAlignment="Start" />
                        <Button Grid.Column="1"
                                Text="Copy"
                                Clicked="OnCopyKeyClicked"
                                BackgroundColor="#E4F3EF"
                                TextColor="#147D72"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="46" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="16"
                    BackgroundColor="#FFF8E8"
                    Stroke="#F3E4BD"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Carrier-powered, not cloud-powered"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#674D17" />
                    <Label Text="Messages use the SIM's default SMS subscription and your carrier plan. Charges may apply. The API confirms Android accepted a request; it cannot confirm delivery."
                           FontSize="12"
                           TextColor="#75643D"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   FontSize="13"
                   TextColor="#B42318"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
