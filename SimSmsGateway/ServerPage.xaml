<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SimSmsGateway.ServerPage"
             Shell.NavBarIsVisible="False"
             Title="Server">
    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
            <Image Source="simsmsgatewaylogo.svg" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" />
            <Label Grid.Column="1" StyleClass="ShellPageTitle" Text="Server" />
        </Grid>
    </Shell.TitleView>
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="20,28,20,28" Spacing="16">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Margin="0,0,0,30">
                <Button StyleClass="Secondary"
                        WidthRequest="46"
                        HeightRequest="46"
                        Padding="0"
                        Text="&#xf060;"
                        FontFamily="FASolid"
                        Clicked="OnBackClicked"
                        SemanticProperties.Description="Back" />
                
                <!--<Border Grid.Column="1" StyleClass="IconBox">
                    <Label StyleClass="Icon" Text="&#xf233;" />
                </Border>-->
                
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                    <Label StyleClass="Title" FontSize="23" Text="Server" />
                </VerticalStackLayout>
            </Grid>

            <Border StyleClass="Hero">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="GATEWAY STATUS" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.4" TextColor="#5EEAD4" />
                            <Label x:Name="StatusTitle" Text="Stopped" FontFamily="OpenSansSemibold" FontSize="28" TextColor="White" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" x:Name="StatusPill" VerticalOptions="Start" Padding="12,7"
                                StrokeThickness="0" StrokeShape="RoundRectangle 20">
                            <Label x:Name="StatusPillLabel" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="0.8" />
                        </Border>
                    </Grid>
                    <Label x:Name="StatusLabel" FontSize="13" TextColor="#C7DADD" LineBreakMode="WordWrap"
                           Text="Start the server to let your apps send SMS through this phone's SIM." />
                    <Button x:Name="ToggleButton" StyleClass="Primary" Text="Start server" Clicked="OnToggleClicked"
                            BackgroundColor="#2DD4BF" TextColor="#06201D" />
                </VerticalStackLayout>
            </Border>

            <Border StyleClass="Card">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border StyleClass="IconBox"><Label StyleClass="Icon" Text="&#xf1eb;" /></Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label StyleClass="Heading" Text="Server address" />
                            <Label StyleClass="Muted" Text="Use the Wi-Fi address from another device." />
                        </VerticalStackLayout>
                    </Grid>
                    <Border StyleClass="Inset">
                        <VerticalStackLayout x:Name="AddressListLayout" Spacing="8" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border StyleClass="Card">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border StyleClass="IconBox"><Label StyleClass="Icon" Text="&#xf084;" /></Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label StyleClass="Heading" Text="API access key" />
                            <Label StyleClass="Muted" Text="Generated on this device each time the app starts." />
                        </VerticalStackLayout>
                    </Grid>
                    <Border StyleClass="Inset">
                        <Label x:Name="ApiKeyLabel" StyleClass="Mono" Text="••••••••••••••••••••••••" />
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button x:Name="RevealButton" StyleClass="Secondary" Text="Show key" Clicked="OnRevealClicked" />
                        <Button Grid.Column="1" StyleClass="Secondary" Text="Copy key" Clicked="OnCopyKeyClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border StyleClass="Card">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border StyleClass="IconBox"><Label StyleClass="Icon" Text="&#xf121;" /></Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label StyleClass="Heading" Text="Try it" />
                            <Label StyleClass="Muted" Text="Run this from a computer on the same Wi-Fi." />
                        </VerticalStackLayout>
                    </Grid>
                    <Border Padding="0" BackgroundColor="#0B1117" Stroke="#263442" StrokeThickness="1"
                            StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="12,9" BackgroundColor="#131B24">
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    <Border WidthRequest="9" HeightRequest="9" BackgroundColor="#FF5F57"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 5" />
                                    <Border WidthRequest="9" HeightRequest="9" BackgroundColor="#FEBC2E"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 5" />
                                    <Border WidthRequest="9" HeightRequest="9" BackgroundColor="#28C840"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 5" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="Terminal  ·  curl example" FontSize="11"
                                       TextColor="#9AA7B4" VerticalOptions="Center" />
                            </Grid>
                            <Label x:Name="SampleLabel" Margin="12,10" Padding="10,10,10,20" FontFamily="monospace" FontSize="12"
                                   HorizontalOptions="Fill" LineBreakMode="WordWrap" TextColor="#C9D1D9" />
                        </VerticalStackLayout>
                    </Border>
                    <Button StyleClass="Secondary" Text="Copy sample command" Clicked="OnCopySampleClicked" />
                </VerticalStackLayout>
            </Border>

            <Border StyleClass="Warn">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label FontFamily="FASolid" FontSize="16" Text="&#xf071;" TextColor="#B7791F" VerticalOptions="Start" />
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label StyleClass="WarnText" FontFamily="OpenSansSemibold" FontSize="13" Text="Before you send" />
                        <Label StyleClass="WarnText"
                               Text="Messages use the SIM's default SMS plan, so carrier charges may apply. Keep this app open while the gateway is running, and only share your API key with apps you trust." />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
