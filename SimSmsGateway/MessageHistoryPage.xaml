<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SimSmsGateway.MessageHistoryPage"
             Shell.NavBarIsVisible="False"
             Title="Message history">
    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
            <Image Source="simsmsgatewaylogo.svg" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" />
            <Label Grid.Column="1" StyleClass="ShellPageTitle" Text="Message history" />
        </Grid>
    </Shell.TitleView>
    <ScrollView>
        <VerticalStackLayout Padding="20,28,20,28" Spacing="16">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Margin="0,0,0,30">
                <Button StyleClass="Secondary"
                        WidthRequest="46"
                        HeightRequest="46"
                        Padding="0"
                        Text="&#xf060;"
                        FontFamily="FASolid"
                        Clicked="OnBackClicked"
                        SemanticProperties.Description="Back" />
                
                <!--<Border Grid.Column="1" StyleClass="IconBox">
                    <Label StyleClass="Icon" Text="&#xf1da;" />
                </Border>-->
                
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                    <Label StyleClass="Title" FontSize="23" Text="Message History" />
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border StyleClass="Card" Padding="14">
                    <VerticalStackLayout Spacing="2">
                        <Label StyleClass="Muted" Text="Total" />
                        <Label x:Name="TotalLabel" StyleClass="Title" FontSize="24" Text="0" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" StyleClass="Card" Padding="14">
                    <VerticalStackLayout Spacing="2">
                        <Label StyleClass="Muted" Text="Success" />
                        <Label x:Name="SuccessLabel" StyleClass="Title" FontSize="24" Text="0"
                               TextColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" StyleClass="Card" Padding="14">
                    <VerticalStackLayout Spacing="2">
                        <Label StyleClass="Muted" Text="Failed" />
                        <Label x:Name="FailedLabel" StyleClass="Title" FontSize="24" Text="0"
                               TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button x:Name="FilterAll" Text="All" Clicked="OnFilterClicked" CommandParameter="all" />
                <Button x:Name="FilterSuccess" Grid.Column="1" Text="Success" Clicked="OnFilterClicked" CommandParameter="success" />
                <Button x:Name="FilterFailed" Grid.Column="2" Text="Failed" Clicked="OnFilterClicked" CommandParameter="failed" />
            </Grid>

            <VerticalStackLayout x:Name="HistoryList" Spacing="10" BindableLayout.ItemsSource="{Binding Messages}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border StyleClass="Card" Padding="14">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Destination}" StyleClass="Heading" FontSize="15" />
                                    <Border Grid.Column="1" Padding="10,4" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{Binding BadgeBackground}">
                                        <Label Text="{Binding StatusText}" FontFamily="OpenSansSemibold" FontSize="11"
                                               TextColor="{Binding BadgeForeground}" />
                                    </Border>
                                </Grid>
                                <Label Text="{Binding Message}" StyleClass="Body" MaxLines="3" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding CreatedAtText}" StyleClass="Muted" FontSize="11" />
                                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" FontSize="12" TextColor="#DC2626" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Border x:Name="EmptyCard" StyleClass="Card" IsVisible="False">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Padding="0,14">
                    <Border StyleClass="IconBox" HorizontalOptions="Center"><Label StyleClass="Icon" Text="&#xf1da;" /></Border>
                    <Label StyleClass="Heading" Text="No messages yet" HorizontalTextAlignment="Center" />
                    <Label StyleClass="Muted" HorizontalTextAlignment="Center"
                           Text="Messages you send through the API will appear here with their success or failed status." />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="LoadOlderButton" StyleClass="Secondary" Text="Load older messages" IsVisible="False" Clicked="OnLoadOlderClicked" />
            <Label x:Name="HistoryStatusLabel" StyleClass="Muted" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
